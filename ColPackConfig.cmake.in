# Provides the imported targets ColPack::ColPack_static and
# ColPack::ColPack_shared.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@COLPACK_ENABLE_OPENMP@)
    find_dependency(OpenMP COMPONENTS CXX)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ColPackTargets.cmake")
check_required_components(ColPack)
