# Provides the imported targets ColPack::ColPack_static and, if ColPack was built
# with COLPACK_BUILD_SHARED, ColPack::ColPack_shared.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@COLPACK_ENABLE_OPENMP@)
    if(MSVC AND NOT DEFINED OpenMP_RUNTIME_MSVC)
        set(OpenMP_RUNTIME_MSVC llvm)
    endif()
    find_dependency(OpenMP COMPONENTS CXX)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ColPackTargets.cmake")
check_required_components(ColPack)
